flowchart LR
    %% ==========================================
    %% TEEN PIPELINE (NeurIPS 2023)
    %% Training-frEE prototype calibratioN for FSCIL
    %% ==========================================

    A["1. Novel Support<br/>(5-shot images)"] 
    --> B["2. Frozen Backbone<br/>(f_theta locked)"] 
    --> C["3. Raw Prototype<br/>(Empirical Mean c_k)"] 
    --> D["4. Semantic Calibration<br/>c_calib = (1-alpha) c_k + alpha c_context"] 
    --> E["5. Calibrated Prototype<br/>(L2-normalized c_calib)"] 
    --> F["6. Cosine Classifier<br/>(Predicted Label y)"]

    %% Pre-computed Base Knowledge
    BASE[("Base Prototypes<br/>{c_b}")] -.->|Semantic Weights w_b| D

    %% Minimalist Modern Styling
    classDef default fill:#F8FAFC,stroke:#64748B,stroke-width:1.5px,color:#0F172A;
    classDef frozen fill:#EEF2FF,stroke:#6366F1,stroke-width:1.5px,stroke-dasharray: 4 4,color:#312E81;
    classDef core fill:#ECFDF5,stroke:#10B981,stroke-width:2px,color:#064E3B;
    classDef base fill:#EFF6FF,stroke:#3B82F6,stroke-width:1.5px,color:#1E3A8A;

    class B frozen;
    class D,E core;
    class BASE base;
