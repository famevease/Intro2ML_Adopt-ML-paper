 subgraph THEORETICAL_FOUNDATION["Statistical Foundation (Lecture 12: Regularization)"]
    direction LR
        ALPHA1["α = 1.0<br>Pure Base Projection<br>⚠️ Severe Bias (Novel Identity Wiped)"]
        ALPHA_OPT["α = 0.1 (Paper Default)<br>James-Stein Shrinkage<br>✅ Optimal Bias-Variance Balance"]
